# Copy to .env and fill in. Source it before launching Kiro or the CLI:
#   set -a; source .env; set +a

# opentide: interpreter kept outside the repo, plus the workspace root
OPENTIDE_VENV=/path/to/.venv-opentide
OPENTIDE_REPO_ROOT=/path/to/this/workspace

# MCP server credentials
SECURITY_DETECTIONS_TOKEN=
SOC_PRIME_TOKEN=
EC_PROXY_URL=
